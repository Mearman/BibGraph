{
	"name": "@bibgraph/web",
	"description": "BibGraph Web App - React SPA for OpenAlex API exploration",
	"version": "0.0.0",
	"type": "module",
	"private": true,
	"repository": {
		"type": "git",
		"url": "https://github.com/Mearman/BibGraph.git",
		"directory": "apps/web"
	},
	"scripts": {
		"_build": "vite build",
		"_dev": "vite",
		"_e2e": "playwright test",
		"_e2e:headed": "playwright test --headed",
		"_e2e:ui": "playwright test --ui",
		"_lint": "eslint . --cache",
		"_preview": "vite preview",
		"_test": "vitest run",
		"_test:component": "vitest run \".component.test.\"",
		"_test:unit": "vitest run \".unit.test.\"",
		"_test:watch": "vitest",
		"_typecheck": "tsc --noEmit",
		"a11y": "sh -c 'vite preview > /dev/null 2>&1 & SERVER_PID=$!; sleep 5; pa11y-ci --config .pa11yci.json || PA11Y_EXIT=$?; kill $SERVER_PID 2>/dev/null || true; wait $SERVER_PID 2>/dev/null || true; exit ${PA11Y_EXIT:-0}'",
		"a11y:dev": "pa11y-ci --config .pa11yci-dev.json",
		"build": "pnpm run _build",
		"clean": "rm -rf dist coverage .tanstack node_modules/.vite",
		"dev": "pnpm run _dev",
		"lint": "pnpm run _lint",
		"preview": "pnpm run _preview",
		"test": "pnpm run _test",
		"test:component": "pnpm run _test:component",
		"test:e2e": "pnpm run _e2e",
		"test:e2e:changed": "playwright test --only-changed --config playwright.config.ts",
		"test:e2e:changed:ci": "playwright test --only-changed=origin/${GITHUB_BASE_REF:-main} --config playwright.config.ts",
		"test:e2e:headed": "pnpm run _e2e:headed",
		"test:e2e:ui": "pnpm run _e2e:ui",
		"test:unit": "pnpm run _test:unit",
		"test:watch": "pnpm run _test:watch",
		"typecheck": "pnpm run _typecheck"
	},
	"dependencies": {
		"@bibgraph/client": "workspace:*",
		"@bibgraph/types": "workspace:*",
		"@bibgraph/ui": "workspace:*",
		"@bibgraph/utils": "workspace:*",
		"@dnd-kit/core": "6.3.1",
		"@dnd-kit/sortable": "10.0.0",
		"@dnd-kit/utilities": "3.2.2",
		"@mantine/core": "9.6.0",
		"@mantine/dates": "9.6.0",
		"@mantine/hooks": "9.6.0",
		"@mantine/modals": "9.6.0",
		"@mantine/notifications": "9.6.0",
		"@posthog/react": "1.10.5",
		"@react-three/drei": "10.7.8",
		"@react-three/fiber": "9.7.0",
		"@tabler/icons-react": "3.46.0",
		"@tanstack/react-query": "5.102.8",
		"@tanstack/react-router": "1.170.32",
		"@tanstack/react-table": "9.2.4",
		"@tanstack/react-virtual": "3.14.10",
		"@types/qrcode": "1.5.6",
		"@vanilla-extract/dynamic": "2.1.5",
		"@vanilla-extract/recipes": "0.5.7",
		"@vanilla-extract/sprinkles": "1.7.1",
		"@xyflow/react": "12.11.6",
		"clsx": "2.1.1",
		"date-fns": "4.4.0",
		"dexie": "4.4.5",
		"idb": "8.0.3",
		"posthog-js": "1.427.2",
		"qrcode": "1.5.4",
		"r3f-forcegraph": "1.1.1",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-force-graph-2d": "1.29.1",
		"react-force-graph-3d": "1.29.1",
		"react-hotkeys-hook": "5.3.3",
		"three": "0.185.1",
		"three-spritetext": "1.10.0",
		"web-vitals": "6.2.1",
		"zod": "4.5.4"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@tanstack/router-vite-plugin": "1.167.35",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.7",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.7",
		"@types/three": "0.185.4",
		"@vanilla-extract/css": "1.21.2",
		"@vanilla-extract/vite-plugin": "5.2.6",
		"@vitest/coverage-v8": "4.1.11",
		"@vitest/ui": "4.1.11",
		"eslint": "10.10.0",
		"fake-indexeddb": "6.2.5",
		"history": "5.3.0",
		"jest-axe": "11.0.0",
		"jsdom": "30.0.1",
		"msw": "2.15.0",
		"tsx": "4.23.13",
		"typescript": "7.0.2",
		"vite": "8.2.2",
		"vite-plugin-pwa": "1.3.0",
		"vitest": "4.1.11",
		"vitest-axe": "0.1.0"
	},
	"author": "Joe Mearman",
	"keywords": [
		"academic",
		"openalex",
		"react",
		"research",
		"tanstack-router",
		"vite"
	],
	"license": "MIT",
	"nx": {
		"includedScripts": []
	}
}
