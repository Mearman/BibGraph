{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
        "experimentalDecorators": true,
    "importHelpers": true,
    "moduleDetection": "force",
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "noImplicitAny": false,
    "incremental": true,
    "assumeChangesOnlyAffectDirectDependencies": true,
    "composite": true,
    "declaration": true,
    "noEmit": true,
    "allowJs": false,
    "strict": true,
    "strictNullChecks": true,
    "noImplicitOverride": false,
    "noPropertyAccessFromIndexSignature": false,
    "noImplicitReturns": false,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false,
    "useDefineForClassFields": true,
    "jsx": "react-jsx",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "typeRoots": ["node_modules/@types", "types"],
    // Workspace path mappings for intra-repo dependencies
    "paths": {
      "@bibgraph/client": ["./packages/client/src/index.ts"],
      "@bibgraph/client/*": ["./packages/client/src/*"],
      "@bibgraph/utils": ["./packages/utils/src/index.ts"],
      "@bibgraph/utils/*": ["./packages/utils/src/*"],
      "@bibgraph/ui": ["./packages/ui/src/index.ts"],
      "@bibgraph/ui/*": ["./packages/ui/src/*"],
      "@bibgraph/types": ["./packages/types/src/index.ts"],
      "@bibgraph/types/*": ["./packages/types/src/*"],
      // Path alias for apps/web internal imports
      "@/*": ["./apps/web/src/*"]
    }
  },
  "include": ["./types/**/*"],
  "exclude": ["node_modules", "tmp"]
}
