{
	"name": "@bibgraph/types",
	"description": "Type definitions, schemas, and type guards for BibGraph",
	"version": "0.0.0",
	"author": "Joe Mearman",
	"dependencies": {
		"zod": "4.5.4"
	},
	"devDependencies": {
		"eslint": "10.10.0",
		"typescript": "7.0.2",
		"vitest": "4.1.11"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"source": "./src/index.ts"
		},
		"./entities": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"source": "./src/entities/index.ts"
		}
	},
	"files": [
		"dist",
		"src",
		"README.md"
	],
	"keywords": [
		"academic",
		"entities",
		"research",
		"schemas",
		"type-guards",
		"types",
		"typescript",
		"zod"
	],
	"license": "MIT",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"nx": {
		"includedScripts": []
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Mearman/BibGraph.git",
		"directory": "packages/types"
	},
	"scripts": {
		"build": "nx run types:build",
		"clean": "nx run types:clean",
		"dev": "nx run types:dev",
		"lint": "nx run types:lint",
		"typecheck": "nx run types:typecheck"
	},
	"type": "module",
	"types": "./dist/index.d.ts"
}
