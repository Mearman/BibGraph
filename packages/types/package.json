{
	"name": "@bibgraph/types",
	"description": "Type definitions, schemas, and type guards for BibGraph",
	"version": "0.0.0",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/Mearman/BibGraph.git",
		"directory": "packages/types"
	},
	"scripts": {
		"_build": "vite build",
		"_lint": "eslint . --cache",
		"_typecheck": "tsc --noEmit",
		"build": "pnpm run _build",
		"clean": "rm -rf dist",
		"dev": "vite build --watch",
		"lint": "pnpm run _lint",
		"typecheck": "pnpm run _typecheck"
	},
	"dependencies": {
		"zod": "4.5.4"
	},
	"devDependencies": {
		"eslint": "10.10.0",
		"typescript": "7.0.2",
		"vitest": "4.1.11"
	},
	"author": "Joe Mearman",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"source": "./src/index.ts",
			"import": "./dist/index.js"
		},
		"./entities": {
			"types": "./dist/index.d.ts",
			"source": "./src/entities/index.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"src",
		"README.md"
	],
	"keywords": [
		"academic",
		"entities",
		"research",
		"schemas",
		"type-guards",
		"types",
		"typescript",
		"zod"
	],
	"license": "MIT",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"nx": {
		"includedScripts": []
	},
	"publishConfig": {
		"access": "public"
	},
	"types": "./dist/index.d.ts"
}
